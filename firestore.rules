rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user owns the document
    function isOwner(data) {
      return data.userId == request.auth.uid;
    }

    // Global rule for all collections
    match /{collection}/{document} {
      // Allow read/update/delete only if the user owns the existing document
      allow read, update, delete: if isAuthenticated() && isOwner(resource.data);
      
      // Allow creation only if the user sets their own UID as the owner
      allow create: if isAuthenticated() && isOwner(request.resource.data);
    }
    
    // Specific validation can be added here for each collection if needed
    // Example:
    // match /enseignants/{id} {
    //   allow create: if isAuthenticated() && 
    //                   request.resource.data.userId == request.auth.uid &&
    //                   request.resource.data.nom is string;
    // }
  }
}
