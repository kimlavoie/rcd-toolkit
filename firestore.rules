rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return request.auth.token.isAdmin == true || request.auth.token.role == 'ADMIN'; // Fallback during migration
    }

    function isCoordinator(deptId) {
      return request.auth.token.departements != null && deptId in request.auth.token.departements && request.auth.token.departements[deptId] == 'COORDONNATEUR';
    }

    function isSameDepartment(departementId) {
      return request.auth.token.departements != null && (departementId in request.auth.token.departements) || request.auth.token.departementId == departementId; // Fallback
    }

    match /departements/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isSuperAdmin();
    }

    match /enseignants/{document} {
      // Les enseignants peuvent être lus par tout utilisateur connecté (le filtrage réel se fait dans la requête frontend)
      allow read: if isAuthenticated();
      // Seul un Super Admin peut modifier/supprimer la fiche racine depuis le frontend
      // (Les coordonnateurs passent par l'API PUT pour modifier le rôle dans leur département)
      allow write: if isAuthenticated() && isSuperAdmin();
    }

    match /{collection}/{document} {
      // Pour toutes les collections métier (cours, groupes, tâches, etc.)
      allow read: if collection != 'departements' && collection != 'enseignants' && isAuthenticated() && (isSameDepartment(resource.data.departementId) || isSuperAdmin());
      allow create: if collection != 'departements' && collection != 'enseignants' && isAuthenticated() && (isCoordinator(request.resource.data.departementId) || isSuperAdmin());
      allow update, delete: if collection != 'departements' && collection != 'enseignants' && isAuthenticated() && (isCoordinator(resource.data.departementId) || isSuperAdmin());
    }
  }
}
